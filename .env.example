# Copy to .env next to deploy/compose.yaml on the server. Non-secret settings only.
# The APNs key goes in ./secrets/apns_key.p8, not here.
# The image tag is no longer set here: it lives in .doco-cd.yml / .doco-cd.prod.yml
# and is bumped by the release pipeline, not by hand.

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
# Production builds: https://api.push.apple.com (default)
# Development builds: https://api.sandbox.push.apple.com
APNS_ENDPOINT=https://api.push.apple.com
